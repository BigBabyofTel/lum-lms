 y (/ (+ t b) 2))\n  (def! seed (. shape :getSeed))\n  (def! g 10)\n  (def! lw (* w 0.15))\n  (def! lh (* h 0.15))\n  (def! island (. shape :getPropertyValue \"Island\"))\n  (def! landscape (< h w))\n  (. canvas :strokeRoundRect l t r b 44)\n  (. canvas :strokeRoundRect (- l g) (- t g) (+ r g) (+ b g) 50)\n  (if island\n    (if landscape\n      (. canvas :strokeRoundRect\n         (+ l g) (- y lh) (+ l (* g 3)) (+ y lh) g)\n      (. canvas :strokeRoundRect\n         (- x lw) (+ t g) (+ x lw) (+ t (* g 3)) g))))"},{"id":"viewport","script":"(do\n  (def! l (. shape :left))\n  (def! r (. shape :right))\n  (def! t (. shape :top))\n  (def! b (. shape :bottom))\n  (def! g 10)\n  [[(- l g) (- t g)] [(+ r g) (+ b g)]])"}],"corners":[42,42,42,42],"textEditable":false},{"id":"oloYgeJ9GcYPLw2NBdA5s","type":"Frame","parent":"wx5AJBttplbMytdjQ7EvU","children":[{"id":"cCNc9SmmVfe7MuZe_YrIY","type":"Rectangle","parent":"oloYgeJ9GcYPLw2NBdA5s","children":[{"id":"Ya4xmkA9hVAZ09aLu03vI","type":"Rectangle","parent":"cCNc9SmmVfe7MuZe_YrIY","children":[{"id":"7gtqrRs3fQk0SLQmU2qkA","type":"Rectangle","parent":"Ya4xmkA9hVAZ09aLu03vI","name":"Tab","tags":["tab"],"sizable":"horz","rotatable":false,"left":444.38,"top":816.92,"width":79.98,"height":32,"strokeWidth":2,"fillColor":"$gray6","fontFamily":"Loranthus","roughness":1,"corners":[8,8,0,0],"text":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"Stream"}]}]},"wordWrap":true},{"id":"adJEpNVyW50GjMWLgpZ2j","type":"Rectangle","parent":"Ya4xmkA9hVAZ09aLu03vI","name":"Tab","tags":["tab"],"sizable":"horz","rotatable":false,"left":524.36,"top":816.92,"width":109.97,"height":32,"strokeWidth":2,"fontFamily":"Loranthus","roughness":1,"corners":[8,8,0,0],"text":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"Assignments"}]}]},"wordWrap":true},{"id":"htmMsrgDMgCgFe-AJOK9O","type":"Rectangle","parent":"Ya4xmkA9hVAZ09aLu03vI","na